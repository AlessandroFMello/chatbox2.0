# Google AI Studio API key — get yours at https://aistudio.google.com/apikey
AI_API_KEY=your_google_ai_studio_key_here

# Gemini model id (gemini-2.5-flash is the free, streaming-capable default)
AI_MODEL=gemini-2.5-flash

# Mongo connection — defaults work inside docker-compose
MONGO_URI=mongodb://mongo:27017
MONGO_DB=chatterbox

# Comma-separated CORS allow list
CORS_ORIGINS=http://localhost:5173
